---
import './styles.css';
---

<div class="es es-cc not-content" data-es-cc>
	<nav class="es-cc__nav" aria-label="Walkthrough steps">
		<button class="es-button es-cc__arrow" data-prev aria-label="Previous step">←</button>
		<span class="es-cc__position" data-position aria-live="polite"></span>
		<button class="es-button es-cc__arrow" data-next aria-label="Next step">→</button>
	</nav>

	<div class="es-cc__stage">
		<section class="es-panel es-cc__writer" data-writer="a">
			<div class="es-label">Writer A · laptop</div>
			<div class="es-cc__read" data-read>Hasn't read yet</div>
			<div class="es-cc__command" data-command></div>
			<div class="es-cc__result" data-result></div>
		</section>

		<section class="es-panel es-cc__stream-panel">
			<div class="es-label">Stream <code>cart-42</code> <span class="es-cc__version" data-version></span></div>
			<ol class="es-stream es-cc__stream" data-stream></ol>
		</section>

		<section class="es-panel es-cc__writer" data-writer="b">
			<div class="es-label">Writer B · phone</div>
			<div class="es-cc__read" data-read>Hasn't read yet</div>
			<div class="es-cc__command" data-command></div>
			<div class="es-cc__result" data-result></div>
		</section>
	</div>

	<ol class="es-cc__steps" data-steps>
		<li><span class="es-cc__step-text">Both services load <code>cart-42</code>. It's at version 5.</span></li>
		<li><span class="es-cc__step-text">Each decides on a change, based on the version it receives.</span></li>
		<li><span class="es-cc__step-text">A appends first, expecting version 5. It matches, so the event is accepted.</span></li>
		<li><span class="es-cc__step-text">B appends, also expecting version 5. The stream is now at 6, so the append is rejected.</span></li>
		<li><span class="es-cc__step-text">B reloads, reprocessing against the new state, and retries, this time expecting version 6.</span></li>
	</ol>
</div>

<script>
	import { animate } from 'motion';
	import { added, eventCard, enter, removed, sleep, type CartEvent } from './cart';

	const history: CartEvent[] = [added('beans'), added('mug'), added('beans'), removed('beans'), added('filters')];
	const grinder = added('grinder');
	const removeMug = removed('mug');
	const cancelled = Symbol('cancelled');

	for (const root of document.querySelectorAll<HTMLElement>('[data-es-cc]')) {
		const stream = root.querySelector<HTMLElement>('[data-stream]')!;
		const version = root.querySelector<HTMLElement>('[data-version]')!;
		const steps = [...root.querySelectorAll<HTMLElement>('[data-steps] li')];
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const position = root.querySelector<HTMLElement>('[data-position]')!;
		const writer = (id: 'a' | 'b') => {
			const element = root.querySelector<HTMLElement>(`[data-writer="${id}"]`)!;
			return {
				element,
				read: element.querySelector<HTMLElement>('[data-read]')!,
				command: element.querySelector<HTMLElement>('[data-command]')!,
				result: element.querySelector<HTMLElement>('[data-result]')!,
			};
		};
		type Writer = ReturnType<typeof writer>;
		const a = writer('a');
		const b = writer('b');
		let events: CartEvent[] = [];
		let stage = -1;
		let run = 0;
		const running = new Set<ReturnType<typeof animate>>();

		const track = (animation: ReturnType<typeof animate>) => {
			running.add(animation);
			animation.then(() => running.delete(animation));
			return animation;
		};
		const stopAnimations = () => {
			running.forEach((animation) => animation.stop());
			running.clear();
		};

		const setVersion = () => (version.textContent = `version ${events.length}`);
		const showStep = (index: number) => {
			steps.forEach((element, step) => {
				element.classList.toggle('is-active', step === index);
				element.classList.toggle('is-done', step < index);
			});
			position.textContent = index < 0 ? 'Press → to start' : `Step ${index + 1} of ${steps.length}`;
			prev.disabled = index < 0;
			next.disabled = index >= steps.length - 1;
		};

		const reset = () => {
			events = [...history];
			stream.replaceChildren(...events.map((event, index) => eventCard(event, index, { payload: false })));
			setVersion();
			for (const w of [a, b]) {
				w.read.textContent = "Hasn't read yet";
				w.read.classList.remove('is-loaded');
				w.read.style.cssText = '';
				w.command.replaceChildren();
				w.command.classList.remove('is-rejected');
				w.command.style.cssText = '';
				w.result.textContent = '';
				w.result.removeAttribute('data-tone');
			}
		};

		const load = (w: Writer) => {
			w.read.textContent = `Read cart-42 at version ${events.length}`;
			w.read.classList.add('is-loaded');
		};

		const prepare = (w: Writer, event: CartEvent, expected: number) => {
			const card = eventCard(event, expected, { payload: false });
			card.querySelector('.es-event__position')!.textContent = 'new';
			const expectation = document.createElement('div');
			expectation.className = 'es-cc__expect';
			expectation.innerHTML = `expect version <b>${expected}</b>`;
			w.command.replaceChildren(card, expectation);
			w.command.classList.remove('is-rejected');
			w.command.style.cssText = '';
		};

		const commit = (w: Writer, event: CartEvent) => {
			w.command.style.opacity = '0';
			events = [...events, event];
			const card = eventCard(event, events.length - 1, { payload: false });
			stream.append(card);
			setVersion();
			w.result.dataset.tone = 'ok';
			w.result.textContent = `✓ Accepted. Stream is now at version ${events.length}.`;
			return card;
		};

		const refuse = (w: Writer, expected: number) => {
			w.command.classList.add('is-rejected');
			w.result.dataset.tone = 'error';
			w.result.textContent = `✗ Rejected: expected version ${expected}, but the stream is at ${events.length}.`;
		};

		const reload = (w: Writer) => {
			w.read.textContent = `Reloaded at version ${events.length}. The mug is still in the cart, so the removal still makes sense.`;
			w.command.classList.remove('is-rejected');
			w.result.removeAttribute('data-tone');
			w.result.textContent = '';
		};

		const states = [
			() => [a, b].forEach(load),
			() => {
				prepare(a, grinder, 5);
				prepare(b, removeMug, 5);
			},
			() => commit(a, grinder),
			() => refuse(b, 5),
			() => {
				reload(b);
				prepare(b, removeMug, 6);
				commit(b, removeMug);
			},
		];

		const render = (index: number) => {
			reset();
			states.slice(0, index + 1).forEach((state) => state());
		};

		const towardsStream = (w: Writer) => {
			const from = w.command.getBoundingClientRect();
			const to = stream.getBoundingClientRect();
			return {
				x: to.left + to.width / 2 - (from.left + from.width / 2),
				y: to.bottom - (from.top + from.height / 2),
			};
		};

		type Wait = (pending: PromiseLike<unknown>) => Promise<void>;

		const accept = async (w: Writer, event: CartEvent, wait: Wait) => {
			const { x, y } = towardsStream(w);
			await wait(
				track(animate(w.command, { transform: `translate(${x}px, ${y}px) scale(0.9)`, opacity: 0 }, { duration: 0.6, ease: 'easeIn' })),
			);
			const card = commit(w, event);
			card.classList.add('is-current');
			track(enter(card));
			setTimeout(() => card.classList.remove('is-current'), 1600);
		};

		const reject = async (w: Writer, expected: number, wait: Wait) => {
			const { x, y } = towardsStream(w);
			const near = `translate(${x * 0.45}px, ${y * 0.45}px)`;
			const recoil = `translate(${x * 0.35}px, ${y * 0.35}px)`;
			await wait(track(animate(w.command, { transform: near }, { duration: 0.45, ease: 'easeIn' })));
			await wait(track(animate(w.command, { transform: [near, recoil, near, 'translate(0px, 0px)'] }, { duration: 0.5 })));
			refuse(w, expected);
		};

		const transitions: ((wait: Wait) => Promise<void>)[] = [
			async () => {
				for (const w of [a, b]) {
					load(w);
					track(enter(w.read));
				}
			},
			async (wait) => {
				prepare(a, grinder, 5);
				track(enter(a.command));
				await wait(sleep(500));
				prepare(b, removeMug, 5);
				track(enter(b.command));
			},
			(wait) => accept(a, grinder, wait),
			(wait) => reject(b, 5, wait),
			async (wait) => {
				reload(b);
				track(enter(b.read));
				await wait(sleep(1600));
				prepare(b, removeMug, 6);
				track(enter(b.command));
				await wait(sleep(1000));
				await accept(b, removeMug, wait);
			},
		];

		const go = async (target: number) => {
			const current = ++run;
			const previous = stage;
			stage = target;
			stopAnimations();
			showStep(target);

			if (target !== previous + 1) return render(target);

			render(previous);
			const wait: Wait = async (pending) => {
				await pending;
				if (current !== run) throw cancelled;
			};
			try {
				await transitions[target](wait);
			} catch (error) {
				if (error !== cancelled) throw error;
			}
		};

		prev.addEventListener('click', () => go(stage - 1));
		next.addEventListener('click', () => go(stage + 1));

		render(-1);
		showStep(-1);
	}
</script>

<style>
	.es-cc__nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.es-cc__arrow {
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		font-size: var(--sl-text-base);
	}

	.es-cc__position {
		min-width: 9rem;
		color: var(--es-muted);
		font-family: var(--es-mono);
		font-size: var(--sl-text-xs);
		text-align: center;
	}

	.es-cc__stage {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1.1fr 1fr;
		gap: 1rem;
		align-items: start;
	}

	.es-cc__writer {
		min-height: 15rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.es-cc__writer .es-label {
		margin: 0;
	}

	.es-cc__read {
		color: var(--es-muted);
		font-size: var(--sl-text-xs);
	}

	.es-cc__read.is-loaded {
		color: var(--es-info-text);
	}

	.es-cc__command {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-height: 4rem;
	}

	.es-cc__command.is-rejected :global(.es-event) {
		--kind: var(--es-removed);
		opacity: 0.6;
		text-decoration: line-through;
	}

	.es-cc__command :global(.es-cc__expect) {
		color: var(--es-muted);
		font-family: var(--es-mono);
		font-size: var(--sl-text-2xs);
	}

	.es-cc__command :global(.es-cc__expect b) {
		color: var(--es-strong);
	}

	.es-cc__result {
		min-height: 2.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
	}

	.es-cc__result[data-tone='ok'] {
		color: var(--es-added-text);
	}

	.es-cc__result[data-tone='error'] {
		color: var(--es-removed-text);
	}

	.es-cc__version {
		margin-left: auto;
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		font-family: var(--es-mono);
		letter-spacing: 0;
		text-transform: none;
	}

	.es-cc__steps {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
		margin-top: 1.25rem !important;
		counter-reset: step;
	}

	.es-cc__steps li {
		counter-increment: step;
		padding-top: 0.6rem;
		border-top: 3px solid var(--es-border);
		color: var(--es-muted);
		font-size: var(--sl-text-xs);
		transition:
			border-color 0.3s ease,
			color 0.3s ease;
	}

	.es-cc__steps li::before {
		content: counter(step);
		display: block;
		margin-bottom: 0.2rem;
		font-family: var(--es-mono);
		font-weight: 700;
	}

	.es-cc__step-text {
		display: block;
		opacity: 0;
		clip-path: inset(0 0 100% 0);
		transform: translateY(-0.5rem);
		transition:
			clip-path 0.5s ease,
			transform 0.5s ease,
			opacity 0.3s ease;
	}

	.es-cc__steps li:is(.is-active, .is-done) .es-cc__step-text {
		opacity: 1;
		clip-path: inset(0 0 0 0);
		transform: translateY(0);
	}

	.es-cc__steps li.is-done {
		border-color: color-mix(in oklab, var(--sl-color-text-accent) 45%, transparent);
	}

	.es-cc__steps li.is-active {
		border-color: var(--sl-color-text-accent);
		color: var(--es-strong);
	}

	@media (max-width: 50rem) {
		.es-cc__stage {
			grid-template-columns: 1fr 1fr;
		}

		.es-cc__stream-panel {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.es-cc__steps {
			grid-template-columns: 1fr;
		}

		.es-cc__steps li:not(.is-active) {
			display: none;
		}
	}
</style>
