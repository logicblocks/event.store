---
import './styles.css';
import { base } from './library';

type Rung = { title: string; get: string; tasks: { label: string; href: string }[] };

const rungs: Rung[] = [
	{
		title: 'Store and fold',
		get: 'Event-sourced state for one thing, entirely in memory. Enough for a prototype or a test.',
		tasks: [
			{ label: 'Publish events to a stream', href: `${base}/guides/streams-categories-and-logs/#publishing-to-a-stream` },
			{ label: 'Fold a stream into state', href: `${base}/getting-started/` },
			{ label: 'Test projectors and processors', href: `${base}/guides/testing/` },
		],
	},
	{
		title: 'Persist and query',
		get: 'Durable events, safe concurrent writes, and read models you can search.',
		tasks: [
			{ label: 'Run on PostgreSQL', href: `${base}/guides/postgres/` },
			{ label: 'Stop concurrent writers clobbering each other', href: `${base}/guides/concurrency/` },
			{ label: 'Save and search read models', href: `${base}/guides/projection-store/` },
			{ label: 'Use your own payload and state types', href: `${base}/guides/serialisation/` },
		],
	},
	{
		title: 'Process in the background',
		get: 'Read models and side effects that update themselves as events arrive.',
		tasks: [
			{ label: 'React to events as they arrive', href: `${base}/guides/event-processing/` },
			{ label: 'Keep read models up to date', href: `${base}/guides/event-processing/#project-events-into-a-projection-store` },
			{ label: 'Run services and handle errors', href: `${base}/guides/services-and-error-handling/` },
		],
	},
	{
		title: 'Scale out and harden',
		get: 'Several processes sharing the work, failover when one dies, and a database ready for production.',
		tasks: [
			{ label: 'Share the work between processes', href: `${base}/concepts/distributed-event-broker/` },
			{ label: 'Run PostgreSQL in production', href: `${base}/guides/postgres-in-production/` },
			{ label: 'See what the library is doing', href: `${base}/guides/logging/` },
			{ label: 'Write your own storage adapter', href: `${base}/guides/custom-storage-adapters/` },
		],
	},
];
---

<ol class="es ov ov-ladder not-content">
	{
		rungs.map((rung, index) => (
			<li class="ov-ladder__rung" style={`--rung: ${index}`}>
				<span class="ov-ladder__level">Level {index + 1}</span>
				<h3 class="ov-ladder__title">{rung.title}</h3>
				<p class="ov-ladder__get">{rung.get}</p>
				<ul class="ov-ladder__tasks">
					{rung.tasks.map((task) => (
						<li>
							<a href={task.href}>{task.label}</a>
						</li>
					))}
				</ul>
			</li>
		))
	}
</ol>

<style>
	.ov-ladder {
		display: grid !important;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		padding: 0;
	}

	.ov-ladder__rung {
		display: grid;
		grid-row: span 4;
		grid-template-rows: subgrid;
		row-gap: 0.5rem;
		padding: 1rem;
		border: 1px solid var(--es-border);
		border-top: 4px solid color-mix(in oklab, var(--sl-color-text-accent) calc(40% + var(--rung) * 20%), transparent);
		border-radius: var(--es-radius);
		background: var(--es-surface);
	}

	.ov-ladder__level {
		color: var(--sl-color-text-accent);
		font-family: var(--es-mono);
		font-size: var(--sl-text-2xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.ov-ladder__title {
		margin: 0;
		color: var(--es-strong);
		font-size: var(--sl-text-base);
		font-weight: 700;
	}

	.ov-ladder__get {
		margin: 0;
		color: var(--es-muted);
		font-size: var(--sl-text-xs);
	}

	.ov-ladder__tasks {
		display: flex !important;
		flex-direction: column;
		gap: 0.35rem;
		margin-top: 0.25rem !important;
		padding-top: 0.75rem !important;
		border-top: 1px dashed var(--es-border);
		font-size: var(--sl-text-xs);
	}

	.ov-ladder__tasks a::after {
		content: '\00a0→';
	}

	@media (max-width: 56rem) {
		.ov-ladder {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 32rem) {
		.ov-ladder {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
