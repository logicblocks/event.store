<script>
	type Branch = 'demand' | 'background';

	const PLAY_INTERVAL = 5000;

	for (const root of document.querySelectorAll<HTMLElement>('[data-ov-journey]')) {
		const order = JSON.parse(root.querySelector('[data-branches]')!.textContent!) as Record<Branch, string[]>;
		const stepPanels = new Map(
			[...root.querySelectorAll<HTMLElement>('[data-step]')].map((panel) => [panel.dataset.step!, panel]),
		);
		const chips = [...root.querySelectorAll<HTMLElement>('[data-pkg-chip]')];
		const branchButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-branch]')];
		const lists = [...root.querySelectorAll<HTMLElement>('[data-steps]')];
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const play = root.querySelector<HTMLButtonElement>('[data-play]')!;

		let branch: Branch = 'demand';
		let index = 0;
		let timer: number | undefined;

		const stop = () => {
			if (timer !== undefined) window.clearInterval(timer);
			timer = undefined;
			play.textContent = '▶ Play';
		};

		const render = () => {
			const keys = order[branch];
			const key = keys[index];
			for (const [stepKey, panel] of stepPanels) {
				panel.hidden = stepKey !== key;
				if (stepKey === key) {
					panel.querySelector('[data-step-label]')!.textContent = `Step ${index + 1} of ${keys.length}`;
				}
			}
			const lit = stepPanels.get(key)!.dataset.pkgs!.split(' ');
			for (const chip of chips) chip.classList.toggle('is-lit', lit.includes(chip.dataset.pkgChip!));
			for (const button of branchButtons) button.setAttribute('aria-pressed', String(button.dataset.branch === branch));
			for (const list of lists) {
				list.hidden = list.dataset.steps !== branch;
				for (const button of list.querySelectorAll<HTMLButtonElement>('[data-goto]')) {
					const position = Number(button.dataset.goto);
					button.classList.toggle('is-current', position === index);
					button.classList.toggle('is-done', position < index);
					if (position === index) button.setAttribute('aria-current', 'step');
					else button.removeAttribute('aria-current');
				}
			}
			prev.disabled = index === 0;
			next.disabled = index === keys.length - 1;
		};

		const advance = () => {
			if (index < order[branch].length - 1) {
				index += 1;
				render();
			} else stop();
		};

		for (const button of branchButtons) {
			button.addEventListener('click', () => {
				stop();
				branch = button.dataset.branch as Branch;
				if (index >= 4) index = 4;
				render();
			});
		}
		root.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLElement>('[data-goto]');
			if (!target) return;
			stop();
			index = Number(target.dataset.goto);
			render();
		});
		prev.addEventListener('click', () => {
			stop();
			index = Math.max(0, index - 1);
			render();
		});
		next.addEventListener('click', () => {
			stop();
			advance();
		});
		play.addEventListener('click', () => {
			if (timer !== undefined) return stop();
			if (index === order[branch].length - 1) index = 0;
			render();
			play.textContent = '❚❚ Pause';
			timer = window.setInterval(advance, PLAY_INTERVAL);
		});

		render();
	}
</script>
