---
import { Code } from '@astrojs/starlight/components';
import type { JourneyStep } from './library';

interface Props {
	step: JourneyStep;
	number: number;
	headingLevel: 3 | 4;
}

const { step, number, headingLevel } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<li class="ov-step" id={`journey-${step.key}`}>
	<span class="ov-step__num" aria-hidden="true">{number}</span>
	<article class="es-panel ov-step__card">
		<header class="ov-step__header">
			<Heading class="ov-step__title">{step.title}</Heading>
			<ul class="ov-step__pkgs" aria-label="Packages used">
				{
					step.pkgs.map((id) => (
						<li class="ov-chip" data-pkg={id}>
							{id}
						</li>
					))
				}
			</ul>
		</header>
		<div class="ov-step__body">
			<div class="ov-step__text" set:html={step.text} />
			<div class="ov-step__inspector">
				<div class="es-label">What you have now</div>
				<Fragment set:html={step.inspector} />
			</div>
			<div class="ov-step__code">
				<Code code={step.code} lang="python" wrap />
			</div>
		</div>
	</article>
</li>

<style>
	.ov-step {
		--rail: 2.25rem;
		position: relative;
		display: grid;
		grid-template-columns: var(--rail) minmax(0, 1fr);
		gap: 0 0.9rem;
		scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
	}

	.ov-step:not(:last-child)::before {
		content: '';
		position: absolute;
		top: var(--rail);
		bottom: -1.25rem;
		left: calc(var(--rail) / 2 - 1px);
		border-left: 2px solid var(--es-border);
	}

	.ov-step__num {
		display: grid;
		place-items: center;
		width: var(--rail);
		height: var(--rail);
		border: 2px solid var(--sl-color-text-accent);
		border-radius: 50%;
		background: var(--sl-color-bg);
		color: var(--sl-color-text-accent);
		font-family: var(--es-mono);
		font-size: var(--sl-text-xs);
		font-weight: 700;
	}

	.ov-step__card {
		padding: 1.25rem;
	}

	.ov-step__header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-bottom: 1rem;
	}

	.ov-step__title {
		margin: 0;
		color: var(--es-strong);
		font-size: var(--sl-text-xl);
		font-weight: 600;
		line-height: 1.25;
	}

	.ov-step__pkgs {
		display: flex !important;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.ov-step__body {
		display: grid;
		grid-template-areas:
			'text inspector'
			'code inspector';
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		gap: 1rem 1.5rem;
	}

	.ov-step__text {
		grid-area: text;
	}

	.ov-step__inspector {
		grid-area: inspector;
	}

	.ov-step__text > :global(p) {
		margin: 0 0 0.75rem;
	}

	.ov-step__text > :global(p:last-child) {
		margin-bottom: 0;
	}

	.ov-step__code {
		grid-area: code;
	}

	@media (max-width: 64rem) {
		.ov-step__body {
			grid-template-areas: 'text' 'inspector' 'code';
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: auto;
		}
	}

	@media (max-width: 48rem) {
		.ov-step {
			--rail: 1.75rem;
			gap: 0 0.6rem;
		}

		.ov-step__card {
			padding: 1rem;
		}

		.ov-step__title {
			font-size: var(--sl-text-lg);
		}
	}
</style>
